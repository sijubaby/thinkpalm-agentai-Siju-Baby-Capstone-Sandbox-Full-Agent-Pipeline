# Copy this file to .env and put your real key there (do NOT commit .env)
GROQ_API_KEY='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'
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: force provider (groq | openai). Default: groq if GROQ_API_KEY is set
LLM_PROVIDER=groq

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-key-here
